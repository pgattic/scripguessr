<section :if={@unavailable} class="empty-state panel">
  <h1>Game unavailable</h1>
  <p>Open it in the browser where you started, or start a new game.</p>
  <a class="button" href="/">Home</a>
</section>

<section :if={!@game && !@unavailable} class="welcome">
  <div class="intro-copy">
    <span class="pill">Book of Mormon · 5 rounds</span>
    <h1>How well do you<br /> know the verses?</h1>
    <p class="lede">Read a verse. Guess its book and chapter.</p>
    <div class="welcome-actions">
      <a :if={@resume_game} id="resume-game" class="button" href={"/game/#{@resume_game.id}"}>
        Continue game <span aria-hidden="true">→</span>
      </a>
      <button
        id="start-game"
        class={if @resume_game, do: "button secondary", else: "button"}
        phx-click="start"
        disabled={@preparing}
        phx-disable-with="Loading…"
      >
        {if @preparing, do: "Loading…", else: if(@resume_game, do: "New game", else: "Start game")}
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <p :if={@resume_game} class="resume-hint muted">
      Round {@resume_game.current + 1} of 5
    </p>
    <a href="/atlas" class="welcome-study text-button">Explore the Atlas
    <span aria-hidden="true">↗</span></a>
    <p :if={@error} role="alert" class="error">{@error}</p>
  </div>
  <aside class="intro-art" aria-hidden="true">
    <div class="art-orbit"></div>
    <div class="art-book"><span></span><span></span></div>
    <span class="art-star">✳</span>
  </aside>
</section>

<section :if={@game && !@snapshot["finished"]} class="game-page">
  <div class="progress-header">
    <span>Round <strong>{@snapshot["current"] + 1}</strong> / 5</span>
    <span><strong>{Rules.total(@snapshot)}</strong> pts</span>
  </div>
  <div
    class="progress-track"
    role="progressbar"
    aria-label="Game progress"
    aria-valuemin="0"
    aria-valuemax="5"
    aria-valuenow={Enum.count(@snapshot["rounds"], & &1["guess"])}
  >
    <span :for={round <- @snapshot["rounds"]} class={if round["guess"], do: "filled"}></span>
  </div>
  <div class="game-layout">
    <article class="panel verse-panel">
      <div class="verse-label">
        <span>Book of Mormon</span><span :if={@round["guess"]}>{reference(@round)}</span>
      </div>
      <blockquote id="verse-text" class="verse" tabindex="-1">{@round["text"]}</blockquote>
    </article>
    <aside
      id="picker"
      class="panel picker"
      phx-hook="PickerFocus"
      data-step={if @round["guess"], do: "result", else: @step}
    >
      <div class="picker-header">
        <h1 id="picker-heading" tabindex="-1">
          {if @round["guess"], do: "Result", else: "Guess location"}
        </h1>
        <span :if={!@round["guess"]} class="muted">{case @step do
          :book -> "Book"
          :chapter -> "Chapter"
          :ready -> "Confirm"
        end}</span>
      </div>
      <p :if={@error} role="alert" class="error">{@error}</p>
      <nav :if={@book != "" && !@round["guess"]} class="breadcrumbs" aria-label="Your guess">
        <button
          id="edit-book"
          class={if @step == :chapter, do: "crumb current", else: "crumb"}
          phx-click="edit-book"
        >{@book}</button>
        <span :if={@chapter != ""} aria-hidden="true">/</span>
        <button
          :if={@chapter != ""}
          id="edit-chapter"
          class={if @step == :ready, do: "crumb current", else: "crumb"}
          phx-click="edit-chapter"
        >Chapter {@chapter}</button>
        <button
          id="clear-guess"
          class="crumb clear-guess"
          phx-click="clear-guess"
          aria-label="Clear guess"
          title="Clear guess"
        >×</button>
      </nav>
      <div :if={!@round["guess"] && @step == :book} id="book-grid" class="grid book-grid">
        <button
          :for={book <- books(@snapshot)}
          class={if book == @book, do: "choice active", else: "choice"}
          phx-click="choose-book"
          phx-value-book={book}
          aria-pressed={book == @book}
        >{book}</button>
      </div>
      <div :if={!@round["guess"] && @step == :chapter} id="chapter-grid" class="grid chapter-grid">
        <button
          :for={chapter <- chapters(@snapshot, @book)}
          class={if to_string(chapter) == @chapter, do: "choice active", else: "choice"}
          phx-click="choose-chapter"
          phx-value-chapter={chapter}
          aria-label={"Chapter #{chapter}"}
          aria-pressed={to_string(chapter) == @chapter}
        >{chapter}</button>
      </div>
      <form :if={!@round["guess"] && @step == :ready} id="guess-form" phx-submit="guess">
        <input type="hidden" name="guess[round]" value={@snapshot["current"]} />
        <input type="hidden" name="guess[book]" value={@book} />
        <input type="hidden" name="guess[chapter]" value={@chapter} />
        <div class="ready">
          <span class="muted">Your guess</span><strong>{@book} {@chapter}</strong>
        </div>
        <button class="button full-width" phx-disable-with="Submitting…">Submit guess</button>
      </form>
      <div :if={@round["guess"]} id="answer-reveal" class="result" role="status">
        <p :if={@save_error} role="alert" class="error">{@save_error}</p>
        <p class="score">{@round["guess"]["points"]}<span> / 1,000</span></p>
        <p class="distance">{distance_label(@round["guess"]["distance"])}</p>
        <div
          class="score-meter"
          aria-hidden="true"
          data-meter={@round["guess"]["points"] / 10}
          data-meter-stage={@snapshot["current"]}
        >
          <span data-meter-fill style={"width: #{@round["guess"]["points"] / 10}%"}></span>
        </div>
        <div class="result-grid">
          <div><span class="muted">Actual</span><strong>{reference(@round)}</strong></div>
          <div>
            <span class="muted">Guess</span><strong>{@round["guess"]["book"]} {@round["guess"][
              "chapter"
            ]}</strong>
          </div>
        </div>
        <button
          id="read-chapter"
          class="text-button game-read-chapter"
          phx-click="read-chapter"
          phx-value-round={@snapshot["current"]}
        >Read chapter</button>
        <.save_button
          verse={@round}
          saved={@saved_verses}
          user={@current_user}
          source="round"
          index={@snapshot["current"]}
        />
        <button
          id="next-round"
          class="button full-width"
          phx-click="advance"
          phx-value-round={@snapshot["current"]}
          phx-disable-with="Saving…"
        >{if @snapshot["current"] == 4, do: "Finish game", else: "Next round"}<span aria-hidden="true">→</span></button>
      </div>
    </aside>
  </div>
</section>

<section :if={@game && @snapshot["finished"]} class="summary-page">
  <div class="summary-heading">
    <div>
      <p class="eyebrow">5 rounds complete</p><h1>Final score</h1>
    </div><button
      id="play-again"
      class="button"
      phx-click="start"
      disabled={@preparing}
      phx-disable-with="Loading…"
    >{if @preparing, do: "Loading…", else: "Play again"}<span aria-hidden="true">→</span></button>
  </div>
  <p :if={@error} role="alert" class="error">{@error}</p>
  <div class="final-score panel">
    <strong>{Rules.total(@snapshot)}</strong><span>/ 5,000</span>
  </div>
  <div :if={@reward || @xp_reward} id="game-xp-reward" class="panel xp-summary">
    <div>
      <strong class="xp-earned">
        {if @reward, do: "+", else: ""}{Progression.Rules.total_reward(@reward || @xp_reward)} XP{if !@reward,
          do: " available"}
      </strong>
      <p class="muted xp-breakdown">
        {(@reward || @xp_reward).completion_xp} completion · {(@reward || @xp_reward).accuracy_xp} accuracy
      </p>
      <a
        :if={!@reward}
        href={if @current_user, do: "/account", else: "/account/register"}
        class="text-button"
      >
        {if @current_user,
          do: "Save this game’s XP to your account →",
          else: "Create an account to save your XP →"}
      </a>
    </div>
    <.level_progress :if={@reward && @progress} id="game-xp-progress" progress={@progress} />
  </div>
  <div class="round-list">
    <article :for={{round, index} <- Enum.with_index(@snapshot["rounds"])} class="panel">
      <span class="round-number">{index + 1}</span>
      <div>
        <h2>{reference(round)}</h2><p>{round["text"]}</p><span class="muted">Guessed {round[
          "guess"
        ]["book"]} {round["guess"]["chapter"]} · {distance_label(round["guess"]["distance"])}</span>
        <button
          class="text-button game-read-chapter"
          phx-click="read-chapter"
          phx-value-round={index}
        >Read chapter</button>
        <.save_button
          verse={round}
          saved={@saved_verses}
          user={@current_user}
          source="round"
          index={index}
        />
      </div>
      <strong>{round["guess"]["points"]}<small>pts</small></strong>
    </article>
  </div>
</section>

<.chapter_reader
  id="game-reader"
  chapter={if @reading, do: {@reading["book"], @reading["chapter"]}}
  target={if @reading, do: @reading["verse"]}
  verses={@reader}
  error={@reader_error}
  save_error={@save_error}
  user={@current_user}
  saved={@saved_verses}
/>
