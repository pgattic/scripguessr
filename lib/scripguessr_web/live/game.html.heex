<section :if={@unavailable} class="empty-state panel">
  <h1>Game unavailable</h1>
  <p>Open it in the browser where you started, or start a new game.</p>
  <a class="button" href="/">Home</a>
</section>

<section :if={!@game && !@unavailable && !@daily_lobby} class="welcome">
  <div class="intro-copy">
    <span class="pill">Book of Mormon · 5 rounds</span>
    <h1>How well do you<br /> know the verses?</h1>
    <p class="lede">Read a verse. Guess its book and chapter.</p>
    <div class="welcome-actions">
      <a href="/daily" id="daily-game" class="button secondary">Daily game
      <span aria-hidden="true">↗</span></a>
      <a :if={@resume_game} id="resume-game" class="button" href={"/game/#{@resume_game.id}"}>
        Continue game <span aria-hidden="true">→</span>
      </a>
      <button
        id="start-game"
        class={if @resume_game, do: "button secondary", else: "button"}
        phx-click="start"
        disabled={@preparing}
        phx-disable-with="Loading…"
      >
        {if @preparing, do: "Loading…", else: if(@resume_game, do: "New game", else: "Start game")}
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <p :if={@resume_game} class="resume-hint muted">
      Round {@resume_game.current + 1} of 5
    </p>
    <div class="welcome-links">
      <a href="/matches" id="online-matches" class="text-button">Play with a friend
      <span aria-hidden="true">↗</span></a>
      <a href="/atlas" class="text-button">Explore the Atlas <span aria-hidden="true">↗</span></a>
    </div>
    <p :if={@error} role="alert" class="error">{@error}</p>
  </div>
  <aside class="intro-art" aria-hidden="true">
    <div class="art-orbit"></div>
    <div class="art-book"><span></span><span></span></div>
    <span class="art-star">✳</span>
  </aside>
</section>

<section :if={!@game && !@unavailable && @daily_lobby} class="daily-page">
  <span class="pill">{@today} · UTC</span>
  <h1>The daily five.</h1>
  <p class="lede">Same verses. A new challenge every day.</p>
  <div class="panel daily-card">
    <h2>Book of Mormon · 5 rounds</h2>
    <p class="muted">One ranked attempt per account. Finish before midnight UTC.</p>
    <div class="welcome-actions">
      <a
        :if={@daily_attempt}
        id="daily-attempt"
        class="button"
        href={"/game/#{@daily_attempt.id}"}
      >
        {if @daily_attempt.snapshot["finished"], do: "Review results", else: "Continue daily"}
        <span aria-hidden="true">→</span>
      </a>
      <button
        :if={@current_user && !@daily_attempt}
        id="start-daily"
        class="button"
        phx-click="start-daily"
        disabled={@preparing}
        phx-disable-with="Loading…"
      >
        {if @preparing, do: "Loading…", else: "Play today’s game"}
        <span aria-hidden="true">→</span>
      </button>
      <a :if={!@current_user} id="daily-sign-in" href="/account/sign-in" class="button">Sign in to play →</a>
      <a href="/leaderboard?board=daily" class="text-button">Today’s leaderboard →</a>
    </div>
    <p :if={!@current_user} class="muted daily-note">
      New here? <a href="/account/register">Create an account</a>
      or <a href="/">play a random game</a>.
    </p>
    <p :if={@error} role="alert" class="error">{@error}</p>
  </div>
  <a href="/" class="text-button">← Random games</a>
</section>

<section
  :if={@game && @daily_closed && !@snapshot["finished"]}
  id="daily-expired"
  class="panel daily-page daily-card"
>
  <h1>This daily has ended.</h1>
  <p class="muted">
    The {@daily_day} challenge closed at midnight UTC. Unfinished attempts aren’t ranked.
  </p>
  <a href="/daily" class="button">Play today’s game →</a>
</section>

<section :if={@game && !@snapshot["finished"] && !@daily_closed} class="game-page">
  <p :if={@daily_day} id="daily-game-label" class="daily-game-label">
    Daily game · {@daily_day} <span class="muted">· Closes at midnight UTC</span>
  </p>
  <div class="progress-header">
    <span>Round <strong>{@snapshot["current"] + 1}</strong> / 5</span>
    <span><strong>{Rules.total(@snapshot)}</strong> pts</span>
  </div>
  <div
    class="progress-track"
    role="progressbar"
    aria-label="Game progress"
    aria-valuemin="0"
    aria-valuemax="5"
    aria-valuenow={Enum.count(@snapshot["rounds"], & &1["guess"])}
  >
    <span :for={round <- @snapshot["rounds"]} class={if round["guess"], do: "filled"}></span>
  </div>
  <div class="game-layout">
    <.verse_panel text={@round["text"]} reference={if @round["guess"], do: reference(@round)} />
    <.picker
      chapters={@snapshot["chapters"]}
      book={@book}
      chapter={@chapter}
      step={@step}
      round={@snapshot["current"]}
      error={@error}
      revealed={!is_nil(@round["guess"])}
    >
      <.round_feedback
        :if={@round["guess"]}
        answer={reference(@round)}
        round={@snapshot["current"]}
      >
        <:answer_actions>
          <.icon_button
            id="read-chapter"
            name="book"
            label="Read chapter"
            phx-click="read-chapter"
            phx-value-round={@snapshot["current"]}
          />
          <.save_button
            verse={@round}
            saved={@saved_verses}
            user={@current_user}
            source="round"
            index={@snapshot["current"]}
          />
        </:answer_actions>
        <:player
          name="You"
          self={true}
          guess={"#{@round["guess"]["book"]} #{@round["guess"]["chapter"]}"}
          points={@round["guess"]["points"]}
          distance={@round["guess"]["distance"]}
        />
        <p :if={@save_error} role="alert" class="error">{@save_error}</p>

        <button
          id="next-round"
          class="button full-width"
          phx-click="advance"
          phx-value-round={@snapshot["current"]}
          phx-disable-with="Saving…"
        >{if @snapshot["current"] == 4, do: "Finish game", else: "Next round"}<span aria-hidden="true">→</span></button>
      </.round_feedback>
    </.picker>
  </div>
</section>

<section :if={@game && @snapshot["finished"]} class="summary-page">
  <div class="summary-heading">
    <div>
      <p class="eyebrow">
        {if @daily_day, do: "Daily game · #{@daily_day}", else: "5 rounds complete"}
      </p><h1>Final score</h1>
    </div><button
      id="play-again"
      class="button"
      phx-click="start"
      disabled={@preparing}
      phx-disable-with="Loading…"
    >{cond do
      @preparing -> "Loading…"
      @daily_day -> "Random game"
      true -> "New game"
    end}<span aria-hidden="true">→</span></button>
  </div>
  <p :if={@error} role="alert" class="error">{@error}</p>
  <div class="final-score panel">
    <strong>{Rules.total(@snapshot)}</strong><span>/ 5,000</span>
  </div>
  <div :if={@daily_day} id="daily-results" class="panel daily-card">
    <div class="daily-result-heading">
      <strong :if={@daily_rank}>Rank #{@daily_rank.rank} <span class="muted">· Daily score</span></strong>
      <a
        href={"/leaderboard?" <> URI.encode_query(%{board: "daily", date: Date.to_iso8601(@daily_day)})}
        class="text-button"
      >Daily leaderboard →</a>
    </div>
    <details class="daily-share">
      <summary>Share result</summary>
      <label for="daily-result" class="sr-only">Spoiler-free daily result</label>
      <textarea id="daily-result" rows="4" readonly spellcheck="false">{daily_result(@game)}</textarea>
      <button type="button" id="copy-daily-result" phx-hook="CopyResult" class="text-button">Copy result</button>
      <span id="copy-daily-status" role="status" class="muted"></span>
    </details>
  </div>
  <div :if={@reward || @xp_reward} id="game-xp-reward" class="panel xp-summary">
    <div>
      <strong class="xp-earned">
        {if @reward, do: "+", else: ""}{Progression.Rules.total_reward(@reward || @xp_reward)} XP{if !@reward,
          do: " available"}
      </strong>
      <p class="muted xp-breakdown">
        {(@reward || @xp_reward).completion_xp} completion · {(@reward || @xp_reward).accuracy_xp} accuracy
      </p>
      <a
        :if={!@reward}
        href={if @current_user, do: "/account", else: "/account/register"}
        class="text-button"
      >
        {if @current_user,
          do: "Save this game’s XP to your account →",
          else: "Create an account to save your XP →"}
      </a>
    </div>
    <.level_progress :if={@reward && @progress} id="game-xp-progress" progress={@progress} />
  </div>
  <div class="round-list">
    <article :for={{round, index} <- Enum.with_index(@snapshot["rounds"])} class="panel">
      <span class="round-number">{index + 1}</span>
      <div>
        <div class="answer-heading">
          <h2>{reference(round)}</h2>
          <div class="answer-actions">
            <.icon_button
              name="book"
              label="Read chapter"
              phx-click="read-chapter"
              phx-value-round={index}
            />
            <.save_button
              verse={round}
              saved={@saved_verses}
              user={@current_user}
              source="round"
              index={index}
            />
          </div>
        </div>
        <p>{round["text"]}</p><span class="muted">Guessed {round[
          "guess"
        ]["book"]} {round["guess"]["chapter"]} · {distance_label(round["guess"]["distance"])}</span>
      </div>
      <strong>{round["guess"]["points"]}<small>pts</small></strong>
    </article>
  </div>
</section>

<.chapter_reader
  id="game-reader"
  chapter={if @reading, do: {@reading["book"], @reading["chapter"]}}
  target={if @reading, do: @reading["verse"]}
  verses={@reader}
  error={@reader_error}
  save_error={@save_error}
  user={@current_user}
  saved={@saved_verses}
/>
